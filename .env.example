# =============================================================================
# WORKPULSE ENTERPRISE & BACKUP ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# NOTA DE SEGURANÇA E ZERO TRUST:
# Este arquivo documenta as variáveis de ambiente para todos os componentes.
# NUNCA insira senhas, segredos criptográficos ou chaves reais neste arquivo.
# Configure as variáveis reais no painel do Vercel, Supabase ou Vault do Agent.
# =============================================================================

# =============================================================================
# [1] CONTROL PLANE — SAAS & VERCEL (FRONTEND & API BFF)
# =============================================================================
# Ambiente de execução: development | staging | production
NODE_ENV="production"
# Porta do servidor HTTP local (desenvolvimento / container)
PORT=3000
# URL pública do Control Plane no Vercel ou domínio customizado
APP_URL="https://app.workpulse.com.br"
# Segredo para assinatura de cookies e sessões de usuário (64 bytes hex aleatório)
SESSION_SECRET="CHANGE_ME_SESSION_SECRET_64_HEX"
# Chave da API do Google Gemini (para módulo de People Analytics e Relatórios)
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# =============================================================================
# [2] SUPABASE — DATABASE, AUTH & RLS (POSTGRESQL)
# =============================================================================
# URL da API do projeto Supabase (Frontend-Safe)
SUPABASE_URL="https://xyzcompany.supabase.co"
# Chave anônima pública do Supabase (Frontend-Safe com RLS ativo)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Chave de Serviço com bypass de RLS (USO ESTRITAMENTE SERVER-SIDE / CONTROL PLANE API)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Segredo JWT para decodificação e validação de tokens nos endpoints
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET_HERE"
# String de conexão direta PostgreSQL (para migrations e CLI do Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.xyzcompany.supabase.co:5432/postgres"

# =============================================================================
# [3] CONTROL PLANE & AGENT MUTUAL HANDSHAKE (ZERO TRUST AUTH)
# =============================================================================
# Segredo mestre compartilhado para registro de novos Agentes (Bootstrap)
AGENT_REGISTRATION_SECRET="sec_reg_token_CHANGE_ME_IN_PROD"
# Segredo HMAC para assinatura de tokens efêmeros de sessão do Agente
AGENT_TOKEN_SECRET="sec_hmac_agent_CHANGE_ME_IN_PROD"
# Endpoint WebSocket seguro para conexão duplex dos Agentes com o Control Plane
AGENT_WS_ENDPOINT="wss://app.workpulse.com.br/api/v1/agents/ws"

# =============================================================================
# [4] AUDITORIA IMUTÁVEL & INTEGRIDADE DE PENTEST
# =============================================================================
# Chave secreta HMAC SHA-256 para encadeamento da trilha de auditoria (WORM)
SECURITY_HMAC_SECRET="CHANGE_ME_HMAC_SECRET_HEX_64_BYTES"
# Chave secreta para assinatura dos relatórios e selos digitais de pentest
REPORT_SIGNING_KEY="CHANGE_ME_RSA_OR_HMAC_SIGNING_KEY"

# =============================================================================
# [5] DATA PLANE — BACKUP ENGINE (EXECUÇÃO LOCAL / ISOLADA NA MÁQUINA)
# ATENÇÃO: ESTAS VARIÁVEIS NUNCA DEVEM SER ENVIADAS PARA O VERCEL OU NAVEGADOR
# =============================================================================
# Chave mestre (KEK) para envelope criptográfico local (quando gerenciado via KMS/Vault)
BACKUP_MASTER_KEY="hex_master_kek_32_bytes_do_not_commit"
# Diretório base local para spooling, filas de retry e deduplicação
BACKUP_DATA_DIR="/var/lib/workpulse-backup"
# Diretório para cache temporário de streaming
BACKUP_CACHE_DIR="/tmp/workpulse-backup-cache"
# Caminho do banco local de catálogo e metadados
BACKUP_CATALOG_PATH="/var/lib/workpulse-backup/catalog.db"

# =============================================================================
# [6] DATA PLANE — STORAGE PROVIDERS (CREDENCIAIS DE ARMAZENAMENTO)
# ATENÇÃO: NUNCA EXPOR ESTAS CREDENCIAIS NO VERCEL OU NAVEGADOR
# =============================================================================
# Provedor S3 / Compatível (AWS S3, Cloudflare R2, MinIO, Wasabi)
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="us-east-1"
BACKUP_S3_ACCESS_KEY_ID="AKIA_STORAGE_PROD_KEY"
BACKUP_S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
BACKUP_S3_FORCE_PATH_STYLE="false"

# Provedor SMB / Windows Share
BACKUP_SMB_USERNAME="svc_backup_storage"
BACKUP_SMB_PASSWORD="storage_password_smb_secure"
BACKUP_SMB_DOMAIN="CORP"

# Provedor SFTP
BACKUP_SFTP_USERNAME="backup_sftp_user"
BACKUP_SFTP_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# =============================================================================
# [7] MONITORAMENTO & OBSERVABILIDADE (SECOPS / SOC)
# =============================================================================
# Webhook do Slack/Teams/PagerDuty para incidentes críticos
SOC_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX"
# Nível de log: error | warn | info | debug
LOG_LEVEL="info"
